{
  "name": "stgmetal-windows-server",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop server for SangfoidEns/STGmetal (club JSON + Telegram bot API)",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "server-only": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "pack:win": "electron-packager . STGmetal-Server --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=true --ignore=\"dist|tests|\\.git\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.4"
  }
}
